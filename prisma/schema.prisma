generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Values match the enquiry type ids sent by the website's contact form.
enum EnquiryType {
  general
  trials
  partnership
  media
}

model Enquiry {
  id           String      @id @default(cuid())
  fullName     String
  email        String
  phone        String?
  organisation String?
  type         EnquiryType
  subject      String?
  message      String
  consent      Boolean
  createdAt    DateTime    @default(now())

  @@index([createdAt])
}

enum Squad {
  men
  women
}

enum MatchStatus {
  scheduled
  live
  final
  postponed
  cancelled
}

// A team in a competition: Nansana ASKA's men and women are separate teams.
// `slug` is also the key the website uses to find a team's logo.
model Team {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  squad     Squad
  isOurs    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logo         TeamLogo?
  competitions CompetitionTeam[]
  homeMatches  Match[]           @relation("HomeMatches")
  awayMatches  Match[]           @relation("AwayMatches")
  adjustments  PointsAdjustment[]
}

// The logo image, kept in its own table so listing teams never loads the bytes.
model TeamLogo {
  teamId      String   @id
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
  size        Int
  updatedAt   DateTime @updatedAt
}

// One competition in one season, for example "FAU Futsal Super League 2026/27".
model Competition {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  season        String
  squad         Squad
  pointsForWin  Int      @default(3)
  pointsForDraw Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teams       CompetitionTeam[]
  matches     Match[]
  adjustments PointsAdjustment[]
}

// Which teams are in a competition, so the table lists every team from
// matchday zero, even before they have played.
model CompetitionTeam {
  competitionId String
  teamId        String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([competitionId, teamId])
}

model Match {
  id            String      @id @default(cuid())
  slug          String      @unique
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  stage         String // for example "Matchday 14" or "Quarter-final"
  matchday      Int?
  // Stored in UTC. Uganda is UTC+3 all year, so the website shows it as EAT.
  kickoffAt     DateTime
  venue         String?
  homeTeamId    String
  awayTeamId    String
  homeTeam      Team        @relation("HomeMatches", fields: [homeTeamId], references: [id])
  awayTeam      Team        @relation("AwayMatches", fields: [awayTeamId], references: [id])
  status        MatchStatus @default(scheduled)
  homeScore     Int?
  awayScore     Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([competitionId, kickoffAt])
  @@index([kickoffAt])
}

// Points added or removed by the league outside normal results, for example a
// deduction. Rare, but real tables need it.
model PointsAdjustment {
  id            String      @id @default(cuid())
  competitionId String
  teamId        String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  points        Int
  reason        String
  createdAt     DateTime    @default(now())

  @@index([competitionId])
}

enum Role {
  admin
  editor
}

// People who can sign in to the admin. There is no public sign-up.
model User {
  id           String    @id @default(cuid())
  email        String    @unique // always stored in lower case
  name         String
  passwordHash String
  role         Role      @default(editor)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]
}

// Only a SHA-256 hash of the session token is stored, never the token itself.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// A photo, resized and converted to WebP on upload. Used as an article cover,
// inside an article's text, or as a gallery photo.
model MediaImage {
  id          String   @id @default(cuid())
  contentType String
  data        Bytes
  size        Int
  width       Int
  height      Int
  createdAt   DateTime @default(now())

  covers        Article[]
  galleryPhotos GalleryPhoto[]
}

enum ArticleCategory {
  match_reports
  club_updates
  team_academy
  announcements
}

enum ArticleStatus {
  draft
  published
}

model Article {
  id           String          @id @default(cuid())
  slug         String          @unique
  title        String
  excerpt      String          @default("")
  // Markdown. Images inside it point to /media/<id>.
  body         String          @default("")
  category     ArticleCategory
  status       ArticleStatus   @default(draft)
  featured     Boolean         @default(false)
  authorName   String
  coverImageId String?
  coverImage   MediaImage?     @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  readMinutes  Int             @default(1)
  publishedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, publishedAt])
}

enum GalleryCategory {
  match_day
  training
  squads
  supporters
  events
}

// A photo in the public gallery. New uploads start hidden (published = false)
// until someone has given them a title and published them.
model GalleryPhoto {
  id        String          @id @default(cuid())
  imageId   String
  image     MediaImage      @relation(fields: [imageId], references: [id])
  title     String          @default("Untitled photo")
  caption   String          @default("")
  category  GalleryCategory
  // A short tag shown on the card, for example "Matchday 8".
  meta      String?
  wide      Boolean         @default(false)
  featured  Boolean         @default(false)
  published Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([published, createdAt])
}

enum PlayerPosition {
  goalkeeper
  defender
  winger
  pivot
}

enum PlayerRole {
  captain
  vice_captain
}

enum PreferredFoot {
  right
  left
  both
}

enum StaffGroup {
  technical
  management
}

model Player {
  id          String         @id @default(cuid())
  name        String
  squad       Squad
  number      Int?
  position    PlayerPosition
  role        PlayerRole?
  foot        PreferredFoot?
  appearances Int?
  goals       Int?
  cleanSheets Int?
  saves       Int?
  photoId     String?
  published   Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([squad, published])
}

model StaffMember {
  id        String     @id @default(cuid())
  name      String
  // The role line, for example "Head coach — Men's senior".
  title     String
  // A small label above the name, for example "Tactical director".
  kicker    String?
  bio       String     @default("")
  group     StaffGroup @default(technical)
  // Lower numbers are shown first.
  sortOrder Int        @default(0)
  photoId   String?
  published Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([group, published, sortOrder])
}

enum VideoCategory {
  match
  goals
  recaps
  training
  behind
  interviews
}

model Highlight {
  id            String        @id @default(cuid())
  title         String
  description   String        @default("")
  category      VideoCategory
  // Where to watch: a YouTube, Facebook, TikTok... address.
  videoUrl      String
  // Set when videoUrl is a YouTube link. It lets the site play the video in
  // the page and fetch its thumbnail.
  youtubeId     String?
  // The thumbnail is a stored photo (a plain id, like player photos).
  thumbnailId   String?
  // true when the thumbnail was fetched from YouTube automatically.
  thumbnailAuto Boolean       @default(false)
  kicker        String?
  badge         String?
  duration      String?
  // The date shown on the site. Defaults to the day it is added.
  date          DateTime      @default(now())
  spotlight     Boolean       @default(false)
  featured      Boolean       @default(false)
  // Optional: the slug of the match this video is about (for recap scores).
  matchSlug     String?
  published     Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([published, date])
}

// Smaller copies of a stored photo, so cards load a file that fits them. The
// main photo stays in MediaImage. Linked by a plain id like other photo
// references; the media service deletes the copies together with their photo.
model MediaVariant {
  id          String   @id @default(cuid())
  imageId     String
  width       Int
  contentType String   @default("image/webp")
  data        Bytes
  size        Int
  createdAt   DateTime @default(now())

  @@unique([imageId, width])
}
